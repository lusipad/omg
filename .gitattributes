# Preserve the upstream model files for byte-for-byte Git blob verification.
public/models/so101/*.xml -text
public/models/so101/*.urdf -text
public/models/so101/LICENSE -text
public/models/so101/assets/*.stl binary
# The downloadable workpiece and its in-code default are the same assembly input.
public/workcells/ur5e-pick-place/workpiece.xml text eol=lf
# Keep the documented SHA-256 of the downloadable Milo BOM reproducible.
public/machines/milo-v1-5/bom-facts.md text eol=lf
public/machines/milo-v1-5/*.nc text eol=lf
public/assemblies/cnc-factory/*.nc text eol=lf
# The Modelica source and generated artifacts are identified by byte digests.
public/modelica/**/*.json text eol=lf
public/modelica/*.json text eol=lf
public/modelica/*.mo text eol=lf
public/modelica/GouyuanFactory/package.mo text eol=lf
public/modelica/GouyuanFactory/Resources/Include/*.h text eol=lf
public/modelica/MSL-LICENSE.txt -text
public/modelica/runtime/*.wasm binary
scripts/modelica/** text eol=lf
contracts/motor-integration.mjs text eol=lf
